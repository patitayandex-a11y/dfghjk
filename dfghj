-- ============ ESP SYSTEM (ИСПРАВЛЕНО) ============
local ESP = {
    Enabled = false,
    Highlights = {},
    Connections = {},
    Color = Color3.fromRGB(255, 0, 0),
    CharacterWatchers = {},
}

function ESP:AddChams(player)
    if player == Player then return end
    self:RemoveChams(player)
    local char = player.Character
    if not char or not char.Parent then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end

    local hl = Instance.new("Highlight")
    hl.FillColor = self.Color
    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
    hl.FillTransparency = 0.3
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Adornee = char
    hl.Parent = workspace -- ✅ ВАЖНО: не в char!
    self.Highlights[player] = hl

    local conn
    conn = hum.Died:Connect(function()
        self:RemoveChams(player)
        if conn then conn:Disconnect() end
    end)
    table.insert(self.Connections, conn)
end

function ESP:RemoveChams(player)
    if self.Highlights[player] then
        pcall(function() self.Highlights[player]:Destroy() end)
        self.Highlights[player] = nil
    end
end

function ESP:WatchCharacter(player)
    if player == Player then return end
    if self.CharacterWatchers[player] then
        self.CharacterWatchers[player]:Disconnect()
        self.CharacterWatchers[player] = nil
    end

    self.CharacterWatchers[player] = player.CharacterAdded:Connect(function(newChar)
        newChar:WaitForChild("Humanoid", 10)
        task.wait(0.5)
        if self.Enabled and newChar.Parent then
            self:AddChams(player)
        end
    end)
end

function ESP:Enable()
    if self.Enabled then return end
    self.Enabled = true

    for _, p in pairs(Players:GetPlayers()) do
        if p ~= Player then
            self:AddChams(p)
            self:WatchCharacter(p)
        end
    end

    table.insert(self.Connections, Players.PlayerAdded:Connect(function(p)
        if self.Enabled and p ~= Player then
            self:AddChams(p)
            self:WatchCharacter(p)
        end
    end))

    table.insert(self.Connections, Players.PlayerRemoving:Connect(function(p)
        self:RemoveChams(p)
        if self.CharacterWatchers[p] then
            self.CharacterWatchers[p]:Disconnect()
            self.CharacterWatchers[p] = nil
        end
    end))
end

function ESP:Disable()
    if not self.Enabled then return end
    self.Enabled = false
    for _, c in pairs(self.Connections) do c:Disconnect() end
    self.Connections = {}
    for p, watcher in pairs(self.CharacterWatchers) do
        if watcher then watcher:Disconnect() end
    end
    self.CharacterWatchers = {}
    for p, hl in pairs(self.Highlights) do
        if hl then pcall(function() hl:Destroy() end) end
    end
    self.Highlights = {}
end

function ESP:SetColor(c)
    self.Color = c
    for _, hl in pairs(self.Highlights) do
        if hl then hl.FillColor = c end
    end
end

-- ============ HITBOX EXPANDER (ИСПРАВЛЕНО) ============
local HitboxExpander = {
    Enabled = false,
    OriginalSizes = {},
    Connections = {},
    SizeMultiplier = 2.5,
}

function HitboxExpander:ExpandHead(player)
    if player == Player then return end
    local char = player.Character
    if not char or not char.Parent then return end
    local head = char:FindFirstChild("Head")
    if not head then return end

    if not self.OriginalSizes[player] then
        self.OriginalSizes[player] = head.Size
    end

    head.Size = self.OriginalSizes[player] * Vector3.new(
        self.SizeMultiplier, self.SizeMultiplier, self.SizeMultiplier
    )
    head.CanCollide = false
    head.Massless = true
end

function HitboxExpander:RestoreHead(player)
    local char = player.Character
    if not char then return end
    local head = char:FindFirstChild("Head")
    if not head then return end

    if self.OriginalSizes[player] then
        head.Size = self.OriginalSizes[player]
        self.OriginalSizes[player] = nil
    end
end

function HitboxExpander:SetSize(multiplier)
    self.SizeMultiplier = math.max(multiplier, 0.1)
    if self.Enabled then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= Player then
                self:ExpandHead(p)
            end
        end
    end
end

function HitboxExpander:Enable()
    if self.Enabled then return end
    self.Enabled = true
    print("Hitbox Expander включен")

    for _, p in pairs(Players:GetPlayers()) do
        if p ~= Player then
            self:ExpandHead(p)
            table.insert(self.Connections, p.CharacterAdded:Connect(function()
                task.wait(0.7)
                if self.Enabled then self:ExpandHead(p) end
            end))
        end
    end

    table.insert(self.Connections, Players.PlayerAdded:Connect(function(p)
        if self.Enabled and p ~= Player then
            p.CharacterAdded:Connect(function()
                task.wait(0.7)
                if self.Enabled then self:ExpandHead(p) end
            end)
            if p.Character then self:ExpandHead(p) end
        end
    end))

    table.insert(self.Connections, Players.PlayerRemoving:Connect(function(p)
        self:RestoreHead(p)
    end))
end

function HitboxExpander:Disable()
    if not self.Enabled then return end
    self.Enabled = false
    print("Hitbox Expander выключен")

    for _, c in pairs(self.Connections) do c:Disconnect() end
    self.Connections = {}

    for _, p in pairs(Players:GetPlayers()) do
        if p ~= Player then self:RestoreHead(p) end
    end

    self.OriginalSizes = {}
end
-- ============ AIMBOT SYSTEM (ИСПРАВЛЕНО) ============
local Aimbot = {
    Enabled = false,
    FOV = 60,
    FOVCircle = nil,
    Connection = nil,
    Smoothness = 35,
    AimKey = Enum.KeyCode.E,
    _savedCamType = nil,
    _savedCamSubject = nil,
}

local function IsVisible(target)
    local char = Player.Character
    if not char then return false end
    local head = char:FindFirstChild("Head")
    if not head then return false end
    local targetHead = target:FindFirstChild("Head")
    if not targetHead then return false end

    local params = RaycastParams.new()
    params.FilterDescendantsInstances = {char}
    params.FilterType = Enum.RaycastFilterType.Blacklist
    local dir = (targetHead.Position - head.Position).Unit
    local dist = (targetHead.Position - head.Position).Magnitude
    local result = workspace:Raycast(head.Position, dir * dist, params)

    if result then
        local model = result.Instance:FindFirstAncestorOfClass("Model")
        return model and model == target or false
    end
    return true
end

local function FindTarget()
    local char = Player.Character
    if not char then return nil end
    local cam = workspace.CurrentCamera
    if not cam then return nil end

    local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
    local fovRadius = (Aimbot.FOV / 2) * (cam.ViewportSize.Y / 1080) * 5
    local targets = {}

    for _, p in pairs(Players:GetPlayers()) do
        if p ~= Player then
            local targetChar = p.Character
            if targetChar then
                local hum = targetChar:FindFirstChild("Humanoid")
                if hum and hum.Health > 0 then
                    local targetHead = targetChar:FindFirstChild("Head")
                    if targetHead and IsVisible(targetChar) then
                        local sp = cam:WorldToScreenPoint(targetHead.Position)
                        if sp.Z > 0 then
                            local distFromCenter = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                            if distFromCenter <= fovRadius then
                                local root = char:FindFirstChild("HumanoidRootPart")
                                local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
                                if root and targetRoot then
                                    table.insert(targets, {
                                        Head = targetHead,
                                        Distance = (root.Position - targetRoot.Position).Magnitude,
                                    })
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    table.sort(targets, function(a, b) return a.Distance < b.Distance end)
    return #targets > 0 and targets[1].Head or nil
end

function Aimbot:CreateFOVCircle()
    if self.FOVCircle then self.FOVCircle:Destroy() end

    local gui = Instance.new("ScreenGui")
    gui.Name = "FOVCircle"
    gui.Parent = Player:WaitForChild("PlayerGui")
    gui.ResetOnSpawn = false
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Global
    gui.DisplayOrder = 999998
    gui.IgnoreGuiInset = true

    local cam = workspace.CurrentCamera
    local radius = (self.FOV / 2) * (cam.ViewportSize.Y / 1080) * 5

    local circle = Instance.new("Frame")
    circle.AnchorPoint = Vector2.new(0.5, 0.5)
    circle.Size = UDim2.new(0, radius * 2, 0, radius * 2)
    circle.Position = UDim2.new(0.5, 0, 0.5, 0)
    circle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    circle.BackgroundTransparency = 0.85
    circle.BorderSizePixel = 0
    circle.ZIndex = 999999
    circle.Parent = gui

    Rounded(circle, radius)

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(255, 255, 255)
    stroke.Thickness = 1
    stroke.Transparency = 0.3
    stroke.Parent = circle

    self.FOVCircle = gui
end

function Aimbot:Enable()
    if self.Enabled then return end
    self.Enabled = true
    print("Aimbot включен")

    local cam = workspace.CurrentCamera
    if cam then
        self._savedCamType = cam.CameraType
        self._savedCamSubject = cam.CameraSubject
    end

    self:CreateFOVCircle()

    self.Connection = RunService.RenderStepped:Connect(function()
        if not UserInputService:IsKeyDown(self.AimKey) then return end
        local target = FindTarget()
        if target then
            local cam = workspace.CurrentCamera
            if cam then
                local lookAt = CFrame.lookAt(cam.CFrame.Position, target.Position)
                cam.CFrame = cam.CFrame:Lerp(lookAt, self.Smoothness / 100)
            end
        end
    end)
end

function Aimbot:Disable()
    if not self.Enabled then return end
    self.Enabled = false
    print("Aimbot выключен")

    if self.Connection then self.Connection:Disconnect() self.Connection = nil end
    if self.FOVCircle then self.FOVCircle:Destroy() self.FOVCircle = nil end

    local cam = workspace.CurrentCamera
    if cam then
        if self._savedCamType then cam.CameraType = self._savedCamType end
        if self._savedCamSubject then cam.CameraSubject = self._savedCamSubject end
    end
end

