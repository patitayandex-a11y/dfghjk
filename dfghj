function Menu:CreateTab(name)
    local container = Instance.new("ScrollingFrame")
    container.Size = UDim2.new(1, -30, 1, -105)
    container.Position = UDim2.new(0, 15, 0, 95)
    container.BackgroundTransparency = 1
    container.BorderSizePixel = 0
    container.ZIndex = 1000000
    container.Parent = MainFrame
    container.ScrollingDirection = Enum.ScrollingDirection.Y
    container.ScrollBarThickness = 4
    container.ScrollBarImageColor3 = Color3.fromRGB(80, 80, 90)
    container.CanvasSize = UDim2.new(0, 0, 0, 0)
    container.AutomaticCanvasSize = Enum.AutomaticSize.Y
    container.Visible = false

    local tabBtn = Instance.new("TextButton")
    tabBtn.Size = UDim2.new(1 / math.max(#self.Tabs + 1, 1), -3, 1, -6)
    tabBtn.Position = UDim2.new(#self.Tabs / math.max(#self.Tabs + 1, 1), 0, 0, 3)
    tabBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 50)
    tabBtn.BorderSizePixel = 0
    tabBtn.Text = name
    tabBtn.TextColor3 = Color3.fromRGB(150, 150, 150)
    tabBtn.Font = Enum.Font.GothamBold
    tabBtn.TextSize = 15
    tabBtn.AutoButtonColor = false
    tabBtn.ZIndex = 1000001
    tabBtn.Parent = TabPanel

    Rounded(tabBtn, 15)

    tabBtn.MouseButton1Click:Connect(function()
        for _, cont in pairs(self.Containers) do
            cont.Visible = false
        end
        container.Visible = true

        for _, tab in pairs(self.Tabs) do
            tab.BackgroundColor3 = Color3.fromRGB(45, 45, 50)
            tab.TextColor3 = Color3.fromRGB(150, 150, 150)
        end
        tabBtn.BackgroundColor3 = Color3.fromRGB(70, 70, 80)
        tabBtn.TextColor3 = Color3.fromRGB(220, 220, 220)
    end)

    table.insert(self.Tabs, tabBtn)
    self.Containers[name] = container

    local count = #self.Tabs
    for i, tab in pairs(self.Tabs) do
        tab.Size = UDim2.new(1 / count, -3, 1, -6)
        tab.Position = UDim2.new((i - 1) / count, 0, 0, 3)
    end

    if #self.Tabs == 1 then
        container.Visible = true
        tabBtn.BackgroundColor3 = Color3.fromRGB(70, 70, 80)
        tabBtn.TextColor3 = Color3.fromRGB(220, 220, 220)
    end

    return container
end

